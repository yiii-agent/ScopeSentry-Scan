# ScopeSentry-Scan 扫描节点环境变量模板(build/.env,由 compose 的 env_file 引用)
# 用法:cp build/.env.example build/.env 并填入与服务端一致的强随机密码
# 注意:build/.env 含真实凭据,已被 .gitignore 忽略,严禁提交
NodeName=node
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
MONGODB_IP=127.0.0.1
MONGODB_PORT=27017
REDIS_IP=127.0.0.1
REDIS_PORT=6379
